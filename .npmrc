# better-sqlite3 v13 ships Node-API prebuilds (prebuilds/win32-x64.node) and sets
# "gypfile": false, so it needs no compiler. But npm loses that flag when it
# installs from package-lock.json, falls back to `node-gyp rebuild`, and fails on
# machines without a C++ toolchain (e.g. Windows without VS Build Tools).
# Nothing in this tree needs an install script, so skip them all.
ignore-scripts=true
